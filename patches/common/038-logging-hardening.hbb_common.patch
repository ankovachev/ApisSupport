+// Apis (P13): IPv4 and full-form IPv6 addresses become `<ip>`.
+#[cfg(not(debug_assertions))]
+fn apis_redacted_format(
+    w: &mut dyn std::io::Write,
+    now: &mut flexi_logger::DeferredNow,
+    record: &log::Record,
+) -> Result<(), std::io::Error> {
+    lazy_static::lazy_static! {
+        static ref IP: Option<regex::Regex> = regex::Regex::new(
+            r"\b(?:\d{1,3}\.){3}\d{1,3}\b|\b(?:[0-9a-fA-F]{1,4}:){4,7}[0-9a-fA-F]{1,4}\b",
+        )
+        .ok();
+    }
+    let mut line = Vec::new();
+    flexi_logger::opt_format(&mut line, now, record)?;
+    match IP.as_ref() {
+        Some(ip) => w.write_all(
+            ip.replace_all(&String::from_utf8_lossy(&line), "<ip>")
+                .as_bytes(),
+        ),
+        None => w.write_all(&line),
+    }
+}
