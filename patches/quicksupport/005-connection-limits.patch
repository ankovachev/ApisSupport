+// Apis: translated on the controller (common/041); "not allowed" in the key stops the
+// controller's automatic reconnect (check_if_retry), whatever client it is.
+const APIS_MSG_CONSENT_TIMEOUT: &str = "Consent request not answered, reconnect not allowed";
+const APIS_MSG_BUSY: &str = "The client already has the maximum number of sessions";
+const APIS_MSG_TOO_MANY_PROMPTS: &str = "Too many access requests, try again in a minute";
+
+// Apis (A6): at most this many sessions at once; a further one is refused as busy.
+fn apis_session_limit_reached() -> bool {
+    AUTHED_CONNS.lock().unwrap().len() >= {{MAX_CONNECTIONS}}
+}
+
+lazy_static::lazy_static! {
+    // Apis (A7): when recent consent windows were shown, by controller ID and by address.
+    static ref APIS_CONSENT_PROMPTS: Mutex<std::collections::HashMap<String, Vec<Instant>>> =
+        Default::default();
+}
+
+// Apis (A7): at most this many consent windows a minute per controller ID and per address
+// (the ID is whatever the controller reports, so the address limit is the one that holds).
+// Records the window when it is allowed.
+fn apis_consent_rate_exceeded(peer_id: &str, ip: &str) -> bool {
+    const WINDOW: Duration = Duration::from_secs(60);
+    let mut prompts = APIS_CONSENT_PROMPTS.lock().unwrap();
+    prompts.retain(|_, times| {
+        times.retain(|t| t.elapsed() < WINDOW);
+        !times.is_empty()
+    });
+    let mut keys = vec![format!("id:{peer_id}")];
+    if !ip.is_empty() {
+        keys.push(format!("ip:{ip}"));
+    }
+    if keys
+        .iter()
+        .any(|k| prompts.get(k).map_or(0, |t| t.len()) >= {{MAX_CONSENT_PROMPTS_PER_MINUTE}})
+    {
+        return true;
+    }
+    for k in keys {
+        prompts.entry(k).or_default().push(Instant::now());
+    }
+    false
+}
